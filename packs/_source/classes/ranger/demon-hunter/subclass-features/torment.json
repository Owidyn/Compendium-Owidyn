  "system": {
    "description": {
      "value": "<p>A creature marked by your Hunter's Mark spell has Disadvantage on attack rolls against targets other than you.</p><p>In addition, once per turn when you hit a creature marked by your Hunter's Mark with an attack roll using a weapon or a Ranger spell, you can impose one of the following effects on it.</p><p><strong>Aura of Pain.</strong> The target subtracts 1d4 from the next saving throw it makes before the end of your next turn.</p><p><strong>Chaos Strike.</strong> The target takes an extra 1d8 Fire damage.</p>",
      "chat": ""
    },
